{
    "id": "twittor-chat",
    "name": "Twittor - Chat de Héroes",
    "short_name": "Twittor",
    "description": "Chat en tiempo real para superhéroes, con soporte offline.",
    "lang": "es",
    "dir": "ltr",
    "categories": [
        "social",
        "entertainment"
    ],
    "start_url": "./index.html?source=pwa",
    "scope": "./",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
    ],
    "orientation": "portrait",
    "theme_color": "#3498db",
    "background_color": "#ffffff",
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "share_target": {
        "action": "./index.html",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "shortcuts": [
        {
            "name": "Nuevo mensaje",
            "short_name": "Nuevo",
            "url": "./index.html?accion=nuevo",
            "icons": [
                {
                    "src": "img/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+twittor",
            "url": "./index.html?chat=%s"
        }
    ],
    "file_handlers": [
        {
            "action": "./index.html",
            "accept": {
                "image/*": [
                    ".png",
                    ".jpg",
                    ".jpeg"
                ]
            }
        }
    ],
    "prefer_related_applications": false,
    "edge_side_panel": {
        "preferred_width": 400
    },
    "icons": [
        {
            "src": "img/icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "img/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "img/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}